  "cards": [
    {
      "dot": "cyan",
      "title": "主路径 · 一轮对话",
      "items": [
        "POST /api/v1/chat → chat_turn：R1 配置 → 压缩 → pattern_type 分流",
        "图运行时：条件边 / 挂起恢复 / sends 扇出；回复底层全流式 SSE"
      ]
    },
    {
      "dot": "emerald",
      "title": "四层分层 · host → apps → atoms → nexus",
      "items": [
        "apps ×6：闲鱼客服 / 店铺客服 / 深度研究 / 主题研究 / 安装·维修预约",
        "atoms：执行器 / 工具六件套 / hooks / Provider / 知识库 / MCP 网关",
        "nexus 零业务依赖：默认实现由 atoms import 时反向注册进插件中心"
      ]
    },
    {
      "dot": "amber",
      "title": "信任边界 · 外部依赖 · 热重载",
      "items": [
        "NEXUS_API_KEY 全 API；工具 deny-by-default 三层收口；tool_guard 先播报",
        "外部：百炼 / z.ai LLM（HTTPS + 密钥）、MCP 工具服务、claude CLI、SQLite",
        "热重载：yaml 下一轮生效；/reload 重放重绑；graph_state 挂起续跑"
      ]
    }
  ]
}